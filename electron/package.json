{
  "name": "electron-socket-monitor",
  "version": "1.0.0",
  "description": "多客户端 Socket 监控工具 (Electron 版)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^10.9.1"
  },
  "build": {
    "appId": "com.example.socketmonitor",
    "productName": "SocketMonitor",
    "directories": {
      "output": "dist_new"
    },
    "files": [
      "main.js",
      "preload.js",
      "messageParser.js",
      "webserver.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
